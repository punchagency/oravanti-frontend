# ============================================================================
# Oravanti Frontend - Environment Configuration Example File
# 1. Copy this file: cp .env.example .env
# 2. Fill in all the values based on your development/production setup
# 3. Update variables when switching between environments
# 4. Never commit .env file to version control (already in .gitignore)
# ============================================================================
# 
# NOTE: This file uses Vite environment variables (prefixed with VITE_)
# Vite only exposes variables that start with VITE_ to the browser.
# Reference: https://vitejs.dev/guide/env-and-testing.html
# ============================================================================

# ============================================================================
# API CONFIGURATION - Backend API Connection
# ============================================================================

# Base URL of the backend API server
# Type: string (absolute URL)
# This is used by the authClient to make API calls to the backend
# ⚠️ IMPORTANT: Must match the backend's APP_URL if using cookies for auth
# Examples:
#   - Development (local): http://localhost:3000
#   - Development (Docker): http://api:3000
#   - Staging: https://api-staging.oravanti.com
#   - Production: https://api.oravanti.com
VITE_API_URL="http://localhost:3000"

# ============================================================================
# FRONTEND CONFIGURATION - Application URLs
# ============================================================================

# Base URL of the frontend application
# Type: string (absolute URL)
# Used for generating links, redirects, and canonical URLs
# Examples:
#   - Development (local): http://localhost:5173
#   - Development (Docker): http://frontend:5173
#   - Staging: https://staging.oravanti.com
#   - Production: https://app.oravanti.com
VITE_BASEURL="http://localhost:5173"

# App domain hostname (no scheme, no port)
# Type: string (hostname)
# Used by the tenant layer to detect when the app is served on a firm's custom
# domain instead of the Oravanti app domain. When set, the tenant (white-label)
# React tree is served for any hostname that is not in the app-host list.
# If unset, the hostname of VITE_BASEURL is used. localhost is always allowed.
# Examples:
#   - Development (local): leave unset (localhost handled automatically)
#   - Staging: staging.oravanti.com
#   - Production: app.oravanti.com
VITE_APP_DOMAIN="app.oravanti.com"

# ============================================================================
# BETTER_AUTH CONFIGURATION - Authentication Callbacks
# Reference: https://better-auth.com/docs
# ============================================================================

# Email verification callback URL
# Type: string (absolute path within VITE_BASEURL)
# Where the user is redirected after verifying their email
# The email verification link will point to this URL with a token parameter
# Examples:
#   - Development: http://localhost:5173/email-verified
#   - Staging: https://staging.oravanti.com/email-verified
#   - Production: https://app.oravanti.com/email-verified
# Page: Displays confirmation that email was successfully verified
VITE_BETTER_AUTH_EMAIL_VERIFICATION_CALLBACK_URL="http://localhost:5173/email-verified"

# Login callback URL (post-authentication redirect)
# Type: string (absolute path within VITE_BASEURL)
# Where authenticated users are redirected after successful login
# Must be a protected route (guarded by AuthGuard)
# Examples:
#   - Development: http://localhost:5173/admin/dashboard
#   - Staging: https://staging.oravanti.com/admin/dashboard
#   - Production: https://app.oravanti.com/admin/dashboard
# Pages: Admin dashboard, profile, settings, etc.
VITE_BETTER_AUTH_LOGIN_CALLBACK_URL="http://localhost:5173/admin"

# ============================================================================
# OPTIONAL: VITE BUILD CONFIGURATION
# Uncomment and configure as needed
# ============================================================================

# Enable source maps in production (useful for debugging)
# Type: boolean (true/false)
# Note: This increases bundle size - only use for staging/debugging
# VITE_SOURCEMAP=false

# API request timeout (in milliseconds)
# Type: number
# Optional: Custom timeout for API calls if backend is slow
# VITE_API_TIMEOUT=30000

# ============================================================================
# DEVELOPMENT NOTES FOR TEAM
# ============================================================================

# When updating these URLs:
# 1. Keep VITE_API_URL and backend's CORS_ORIGIN in sync
# 2. Keep VITE_BASEURL and backend's BETTER_AUTH_URL in sync
# 3. For Docker: use container service names instead of localhost
# 4. For production: always use HTTPS URLs
# 5. Callbacks must be exact - trailing slashes and paths matter

# Common troubleshooting:
# - CORS errors? → Check VITE_API_URL matches backend's CORS_ORIGIN
# - 2FA redirect failing? → Verify /auth/2fa path handling in backend redirect config
# - Email verification link not working? → Verify callback URL includes full domain
# - Auth cookies not persisting? → Ensure VITE_API_URL has matching domain (for same-site cookies)

# ============================================================================
# REFERENCE: ALL AVAILABLE ROUTES
# ============================================================================

# Public routes (no authentication required):
#   - /login
#   - /sign-up
#   - /forgot-password
#   - /reset-password
#   - /email-verification
#   - /email-verified (VITE_BETTER_AUTH_EMAIL_VERIFICATION_CALLBACK_URL)

# Protected routes (authentication required):
#   - /admin/* (dashboard, settings, clients, cases, tasks, etc.)
#   - /admin (VITE_BETTER_AUTH_LOGIN_CALLBACK_URL)

# Auth flow routes:
#   - /auth/2fa (2-factor authentication verification)
#   - /onboarding/* (post-signup onboarding steps)

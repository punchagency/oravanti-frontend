{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    ".agents/fe-implementation/teams-tab.tsx",
    ".agents/fe-implementation/staff-details.tsx",
    ".agents/fe-implementation/team-details.tsx",
    ".agents/fe-implementation/create-team.tsx",
    ".agents/fe-implementation/create-team-dialog.tsx"
  ]
}
